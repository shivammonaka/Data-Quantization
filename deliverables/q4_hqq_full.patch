+// ===== Q4_HQQ: 4-bit asymmetric, HQQ-style spec =====
+// Spec: scale = 15/(max-min); zero = -min*scale; q = clamp(round(w*scale+zero),0,15)
+//       w = (q - zero)/scale
+// Storage: we keep the algebraically-equivalent {d = 1/scale = (max-min)/15,
+//          m = min = -zero/scale} so that w = q*d + m. This matches Q4_1's
+//          layout exactly, letting the Q4_1 dot product be reused unchanged.
+void quantize_row_q4_hqq_ref(const float * GGML_RESTRICT x, block_q4_hqq * GGML_RESTRICT y, int64_t k) {
+    const int qk = QK4_HQQ;
+    assert(k % qk == 0);
+    const int nb = k / qk;
+
+    for (int i = 0; i < nb; i++) {
+        float min =  FLT_MAX;
+        float max = -FLT_MAX;
+        for (int j = 0; j < qk; j++) {
+            const float v = x[i*qk + j];
+            if (v < min) min = v;
+            if (v > max) max = v;
+        }
+
+        const float range = max - min;
+        const float scale = range > 0.0f ? 15.0f / range : 0.0f; // spec scale
+        const float zero  = -min * scale;                        // spec zero
+        const float d     = scale > 0.0f ? 1.0f / scale : 0.0f;  // stored delta
+
+        y[i].d = GGML_FP32_TO_FP16(d);
+        y[i].m = GGML_FP32_TO_FP16(min);
+
+        for (int j = 0; j < qk/2; ++j) {
+            // spec quant formula, exactly as written
+            float q0f = x[i*qk + 0    + j] * scale + zero;
+            float q1f = x[i*qk + qk/2 + j] * scale + zero;
+            int q0 = (int)roundf(q0f); q0 = q0 < 0 ? 0 : (q0 > 15 ? 15 : q0);
+            int q1 = (int)roundf(q1f); q1 = q1 < 0 ? 0 : (q1 > 15 ? 15 : q1);
+            y[i].qs[j] = (uint8_t)(q0 | (q1 << 4));
+        }
+    }
+}

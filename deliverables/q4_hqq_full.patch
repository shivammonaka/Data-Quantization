+// Q4_HQQ dot product. Named _q8_0 per the assignment spec, but the activation
+// operand is Q8_1: an asymmetric weight format w = q*d + m expands to
+//   sum_i (q_i*d + m)*a_i = d * sum_i(q_i * qa_i) * da  +  m * (da * sum_i qa_i)
+//                         = d*da*sumi + m*s
+// where s = da*sum(qa) is precomputed in block_q8_1. Q8_0 has no such sum, so
+// the offset term could not be formed without it. Layout of block_q4_hqq is
+// identical to block_q4_1, so the inner loop mirrors Q4_1 exactly.
+void ggml_vec_dot_q4_hqq_q8_0_generic(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    const int qk = QK8_1;
+    const int nb = n / qk;
+
+    assert(n % qk == 0);
+    assert(nrc == 1);
+    UNUSED(nrc); UNUSED(bx); UNUSED(by); UNUSED(bs);
+
+    const block_q4_hqq * GGML_RESTRICT x = vx;
+    const block_q8_1   * GGML_RESTRICT y = vy;
+
+    float sumf = 0;
+    for (int ib = 0; ib < nb; ++ib) {
+        int sumi0 = 0;
+        int sumi1 = 0;
+        for (int j = 0; j < qk/2; ++j) {
+            const int v0 = (x[ib].qs[j] & 0x0F);
+            const int v1 = (x[ib].qs[j] >>   4);
+            sumi0 += (v0 * y[ib].qs[j]);
+            sumi1 += (v1 * y[ib].qs[j + qk/2]);
+        }
+        const int sumi = sumi0 + sumi1;
+        sumf += (GGML_CPU_FP16_TO_FP32(x[ib].d)*GGML_CPU_FP16_TO_FP32(y[ib].d))*sumi
+              +  GGML_CPU_FP16_TO_FP32(x[ib].m)*GGML_CPU_FP16_TO_FP32(y[ib].s);
+    }
+    *s = sumf;
+}
